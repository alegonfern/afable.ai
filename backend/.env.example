SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=afable
DB_USER=afable
DB_PASSWORD=afable
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── IA / Agente ──────────────────────────────────────────────
# Proveedor del agente con datos en vivo: 'ollama' (local) | 'ollama_cloud' (Ollama Cloud) | 'anthropic' (Claude)
AI_PROVIDER=ollama
# Modelo Ollama con tool-use (qwen2.5:7b recomendado; llama3.2:3b si quieres más velocidad)
OLLAMA_MODEL=qwen2.5:7b
# Apunta esto a tu servidor de Ollama potente cuando lo tengas
OLLAMA_BASE_URL=http://localhost:11434
# Ollama Cloud (modelos grandes gratuitos alojados por Ollama). Requiere key.
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:120b
# Modelos cloud a mostrar en el selector de la app (separados por coma), ej:
# OLLAMA_CLOUD_MODELS=gpt-oss:120b-cloud,qwen3-coder:480b-cloud
OLLAMA_CLOUD_MODELS=
# Solo necesario si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Busqueda semantica en los documentos de la empresa (Knowledge > Search).
# 'ollama' usa el modelo de abajo corriendo al lado; 'ninguno' la apaga y los
# documentos vuelven a volcarse enteros al prompt. Anthropic no tiene API de
# embeddings: la ANTHROPIC_API_KEY no sirve para esto.
EMBEDDINGS_PROVIDER=ollama
# Hay que bajarlo una vez: `ollama pull embeddinggemma`. 768 dimensiones, la
# misma que guarda la base — cambiar a un modelo de otra dimension exige una
# migracion nueva del campo `embedding` y reindexar (manage.py indexar_conocimiento).
EMBEDDINGS_MODEL=embeddinggemma
# Vacio = usar OLLAMA_BASE_URL. Se separa para poder tener los embeddings en otra maquina.
EMBEDDINGS_BASE_URL=

# Flow Payments
FLOW_API_KEY=tu_api_key_de_flow
FLOW_SECRET_KEY=tu_secret_key_de_flow
FLOW_SANDBOX=True
FRONTEND_URL=http://localhost:3001
FLOW_WEBHOOK_URL=https://tu-dominio.com/api/v1/payments/webhook/confirm/
